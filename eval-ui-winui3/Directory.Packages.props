<Project>
  <!--
    Central Package Management (CPM) for EvalToolkit.

    Reviewer (Opus-4.8, phase A scaffold round) recommended turning this
    on before the engine ports add a fleet of NuGet packages (Polly v8,
    System.CommandLine, MSAL, ClosedXML, PdfPig, DocumentFormat.OpenXml,
    etc.) since version drift across the 5 src + 3 test projects gets
    very hard to chase otherwise. With CPM enabled, individual csprojs
    say <PackageReference Include="X" /> with no version, and the
    version is resolved from <PackageVersion Include="X" Version="..."/>
    entries here.

    Test packages and analyzers live in this file alongside engine
    packages, so smoke tests and ports never disagree on xunit /
    Microsoft.NET.Test.Sdk / etc. versions.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Don't surface CPM-related transitive complaints during the port. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Test harness -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />

    <!-- WorkIQ retry pipeline (workiq-clients-port). -->
    <PackageVersion Include="Polly" Version="8.6.6" />

    <!--
      Reader-port slice 1 — interleaved per-port per cross-review plan:
      CsvHelper drives the CSV/TSV reader; everything else (JSON/JSONL/TXT/MD)
      uses BCL primitives.
    -->
    <PackageVersion Include="CsvHelper" Version="33.0.1" />

    <!--
      Reader-port slice 2 — XLSX via ClosedXML. ClosedXML wraps
      DocumentFormat.OpenXml and provides a higher-level cell/range API
      that's easier to keep parity with SheetJS sheet_to_json than the
      raw OpenXml SAX/DOM. Behavior pinned by empirical node probes (see
      reviewer round 6 ground-truth dump): dup-header _N suffixing
      starting at the 2nd occurrence, __EMPTY synthetic-key fallback for
      missing/over-shoot cells, sparse-row omission, native numeric
      typing, Excel serial dates.
    -->
    <PackageVersion Include="ClosedXML" Version="0.105.0" />


    <!--
      Engine packages get added here as their ports land:

        Polly                            v8 — workiq retry pipeline
        System.CommandLine               beta — eval-gen-native / eval-score-native shims
        CsvHelper                        SheetJS-compat readers
        ClosedXML                        XLSX reader/writer
        UglyToad.PdfPig                  PDF reader (semantic parity)
        DocumentFormat.OpenXml           DOCX / PPTX readers (normalized-text parity)
        System.IO.Hashing                xxhash for stable IDs across runs
        Microsoft.Identity.Client        MSAL core
        Microsoft.Identity.Client.Broker WAM/interactive broker for the WinUI head
        Microsoft.Identity.Client.Extensions.Msal  DPAPI-protected cache
        Markdig                          report rendering in the UI
        H.NotifyIcon.WinUI               system tray (Phase B)
        Microsoft.WindowsAppSDK          WinUI 3 head (Phase B)
        CommunityToolkit.Mvvm            MVVM helpers (Phase B)

      Each port todo adds the matching <PackageVersion /> entry here in
      the same PR as the <PackageReference /> in its csproj.
    -->
    <!--
      Reader-port slice 3 — DOCX via DocumentFormat.OpenXml. Mirrors
      the TS readDocx in eval-gen which uses mammoth.extractRawText.
      mammoth walks the OpenXml document body extracting <w:t> and
      <w:tab/> contents, joining paragraphs with two newlines and
      silently dropping <w:br/>. Pinned at the same version
      ClosedXML 0.105 already brings in transitively so there's no
      version drift between the two readers.
    -->
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.1.1" />

    <!--
      Reader-port slice 3 — PDF via UglyToad.PdfPig. The TS readPdf
      uses pdf-parse v2 (which wraps pdf.js) to extract per-page text;
      PdfPig instead uses its own DocumentLayoutAnalysis text
      extractors. The two libraries' glyph ordering / line
      reconstruction heuristics differ enough that byte-exact raw
      extraction is impossible — PDF parity is therefore SEMANTIC
      ONLY (per Phase 0 / Section 11 / Opus-4.8 round-1 sub-slice C
      guidance). The deterministic post-processing pipeline (control
      char strip, CR normalize, `\n{1,}` split, `[ \t]+` collapse,
      trim, empty filter, chunkText) is byte-exact and probed
      independently of extraction in
      `~/.copilot/session-state/.../pdf-probe/post-process-probe.js`.
      Pin 0.1.14 — current stable on nuget.org.
    -->
    <PackageVersion Include="UglyToad.PdfPig" Version="0.1.14" />
    <!-- The NuGet package id is "PdfPig" (the namespace is
         UglyToad.PdfPig). Older versions used the prefixed id which
         is why the README refers to it that way. Both aliases are
         kept here so package references can use either id. -->
    <PackageVersion Include="PdfPig" Version="0.1.14" />

    <!--
      auth-port slice — real MSAL for the WorkIQ A2A token provider
      (replaces the placeholder in EvalToolkit.WorkIQ/A2ATokenProviders.cs).
      Mirrors MsalA2ATokenProvider in eval-score/node/src/workiq-client.ts
      (msal-node v3.x there).
        - Microsoft.Identity.Client           — PCA, silent flow, device-code flow
        - Microsoft.Identity.Client.Extensions.Msal — MsalCacheHelper for the
            DPAPI-protected on-disk token cache on Windows (libsecret on
            Linux, Keychain on macOS — not used by the WinUI head but kept
            cross-platform for the parity harness and CLI shims).
      Microsoft.Identity.Client.Broker (WAM/interactive broker) is DEFERRED
      to the winui-shell slice because it pulls in Windows-only runtime
      dependencies; the provider exposes an `interactiveAcquireOverride`
      delegate seam that winui-shell will wire up to WAM later.
    -->
    <PackageVersion Include="Microsoft.Identity.Client" Version="4.84.1" />
    <PackageVersion Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.84.1" />

    <!--
      Sources-port slice 18 — third-party adapters that replace the
      JS-only dependencies the TS sources used.

      AngleSharp 1.x: standards-compliant HTML5 parser with the same
      conceptual model as cheerio (selectors → query API → text/attr).
      WebSource.fetch parses crawled HTML with AngleSharp.

      Microsoft.Data.Sqlite 9.x: managed SQLite ADO.NET provider.
      Replaces the better-sqlite3 + child_process shelling the TS
      DatabaseSource used. Bundles SQLitePCLRaw with the e_sqlite3
      runtime so no native dependency is required at packaging time.
      Picked 9.0.0 (current LTS-aligned wave on net9/net10).
    -->
    <PackageVersion Include="AngleSharp" Version="1.3.0" />
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="9.0.0" />

    <!--
      Slice 19 cli-shims — System.CommandLine for `eval-gen-native` and
      `eval-score-native` argument parsing. Mirrors commander.js in
      eval-gen/eval-score node CLIs. Pinned at 2.0.0-beta6.25358.103 — the
      most recent prerelease as of slice-19 implementation.
    -->
    <PackageVersion Include="System.CommandLine" Version="2.0.0-beta6.25358.103" />

    <!--
      Slice 21 winui-shell — WinUI 3 head, .NET 10. WindowsAppSDK 2.1.3
      is the current stable wave supporting net10.0-windows10.0.19041.0
      TFMs. Brings in WinUI 3, AppLifecycle (single-instance + activation),
      Mica / Acrylic backdrops, packaged + unpackaged hosting models.

      CommunityToolkit.Mvvm 8.x supplies ObservableObject /
      ObservableProperty / RelayCommand source generators so view models
      stay terse and the engine port doesn't need to take a dep on
      ReactiveUI or hand-roll INotifyPropertyChanged.

      H.NotifyIcon.WinUI is added separately in slice 24
      (winui-native-plus-tray).
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.1.3" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />

  </ItemGroup>
</Project>
