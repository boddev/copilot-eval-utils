<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Per Opus-4.8 round-4 review: EvalGen does NOT depend on WorkIQ
      (mirrors TS where eval-gen has zero dependency on the agent
      client). The earlier project reference was a scaffold mistake.
      WorkIQ is consumed only by EvalScore (and the WinUI head) which
      gets a direct reference to EvalToolkit.WorkIQ on those projects.
    -->
    <ProjectReference Include="..\EvalToolkit.Core\EvalToolkit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reader-port slice 1: CsvHelper for csv-parse-faithful CSV/TSV. -->
    <PackageReference Include="CsvHelper" />
    <!-- Reader-port slice 2: ClosedXML for SheetJS-faithful XLSX. -->
    <PackageReference Include="ClosedXML" />
    <!-- Reader-port slice 3: DocumentFormat.OpenXml for mammoth-parity DOCX. -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- Reader-port slice 3 (sub-slice C): PdfPig (namespace
         UglyToad.PdfPig) for PDF text extraction. Semantic parity
         only with pdf-parse v2 — see PdfReader xmldoc. -->
    <PackageReference Include="PdfPig" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals to the test assembly so the chunker / converter
         helpers can be unit-tested without flipping them to public.  -->
    <InternalsVisibleTo Include="EvalToolkit.EvalGen.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
