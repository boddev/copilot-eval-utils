<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!--
      Slice 13 (llm-clients-port): EvalGen now depends on WorkIQ so the
      WorkIQ-flavored LLM provider (m365-copilot) can adapt the existing
      IWorkIQClient without duplicating the MCP transport. The TS source
      keeps everything in one file in eval-gen because there is no
      separate WorkIQ module; in C# we already have the shared transport
      in EvalToolkit.WorkIQ, so the LLM-clients port consumes it.
      The workiq-a2a LLM provider does NOT reuse A2AWorkIQClient: it
      implements the eval-gen A2A wire protocol locally (SendMessage)
      while still reusing A2ATokenProviderFactory for auth.
    -->
    <ProjectReference Include="..\EvalToolkit.Core\EvalToolkit.Core.csproj" />
    <ProjectReference Include="..\EvalToolkit.WorkIQ\EvalToolkit.WorkIQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reader-port slice 1: CsvHelper for csv-parse-faithful CSV/TSV. -->
    <PackageReference Include="CsvHelper" />
    <!-- Reader-port slice 2: ClosedXML for SheetJS-faithful XLSX. -->
    <PackageReference Include="ClosedXML" />
    <!-- Reader-port slice 3: DocumentFormat.OpenXml for mammoth-parity DOCX. -->
    <PackageReference Include="DocumentFormat.OpenXml" />
    <!-- Reader-port slice 3 (sub-slice C): PdfPig (namespace
         UglyToad.PdfPig) for PDF text extraction. Semantic parity
         only with pdf-parse v2 — see PdfReader xmldoc. -->
    <PackageReference Include="PdfPig" />
    <!-- Sources-port slice 18: AngleSharp replaces cheerio for HTML
         parsing in WebSource. AngleSharp is the standard .NET HTML5
         parser; supports CSS selectors / DOM querying with the same
         shape as cheerio (selector → collection → text/attr). -->
    <PackageReference Include="AngleSharp" />
    <!-- Sources-port slice 18: Microsoft.Data.Sqlite replaces the
         better-sqlite3 + child_process CLI shelling that the TS
         DatabaseSource used. Proper managed driver — no native
         dependency at packaging time (SQLitePCLRaw bundled).  -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- Expose internals to the test assembly so the chunker / converter
         helpers can be unit-tested without flipping them to public.  -->
    <InternalsVisibleTo Include="EvalToolkit.EvalGen.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
