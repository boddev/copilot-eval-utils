<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Slice 21 winui-shell — WinUI 3 head for the EvalToolkit native product
    line. .NET 10 + Windows App SDK 2.1.3.

    Deployment model (decided in plan section 7): self-contained Windows
    App SDK *and* self-contained .NET runtime, packaged as MSIX. The MSIX
    head turns on packaged mode via WindowsPackageType=MSIX (handled by
    the packaging slice). For local F5 / debugging we use unpackaged
    (WindowsPackageType=None) which lets dotnet build + dotnet run work
    without bouncing through MSIX. The packaged head is built by msbuild
    /t:Publish, not dotnet publish, and is driven by slice 29
    (msix-packaging).

    DisableXamlGeneratedMain=true so we own [STAThread] Main in
    Program.cs — required for the AppInstance single-instance +
    activation routing logic the user-flow needs (opening a .evalgenset
    file from Explorer must hand off to the running window, not spawn a
    second window).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EvalToolkit.UI</RootNamespace>
    <AssemblyName>EvalToolkit.UI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      C# preview required for partial properties (C# 13+). MVVM Toolkit
      8.4's [ObservableProperty] partial-property mode is the only path
      that's WinRT/CsWinRT-compatible for WinUI 3 (per MVVMTK0045).
    -->
    <LangVersion>preview</LangVersion>

    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!--
      Self-contained Windows App SDK (no bootstrapper needed; everything
      in the MSIX). For unpackaged local runs we still leave self-contained
      on so a fresh dev box doesn't need WinAppSDK runtime installed.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EvalToolkit.Core\EvalToolkit.Core.csproj" />
    <ProjectReference Include="..\EvalToolkit.EvalGen\EvalToolkit.EvalGen.csproj" />
    <ProjectReference Include="..\EvalToolkit.EvalScore\EvalToolkit.EvalScore.csproj" />
    <ProjectReference Include="..\EvalToolkit.Jobs\EvalToolkit.Jobs.csproj" />
    <ProjectReference Include="..\EvalToolkit.WorkIQ\EvalToolkit.WorkIQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

</Project>
