<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Slice 21 winui-shell — WinUI 3 head for the EvalToolkit native product
    line. .NET 10 + Windows App SDK 2.1.3.

    Deployment model (decided in plan section 7): self-contained Windows
    App SDK *and* self-contained .NET runtime, packaged as MSIX. The MSIX
    head turns on packaged mode via WindowsPackageType=MSIX (handled by
    the packaging slice). For local F5 / debugging we use unpackaged
    (WindowsPackageType=None) which lets dotnet build + dotnet run work
    without bouncing through MSIX. The packaged head is built by msbuild
    /t:Publish, not dotnet publish, and is driven by slice 29
    (msix-packaging).

    DisableXamlGeneratedMain=true so we own [STAThread] Main in
    Program.cs — required for the AppInstance single-instance +
    activation routing logic the user-flow needs (opening a .evalgenset
    file from Explorer must hand off to the running window, not spawn a
    second window).
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>EvalToolkit.UI</RootNamespace>
    <AssemblyName>EvalToolkit.UI</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!--
      C# preview required for partial properties (C# 13+). MVVM Toolkit
      8.4's [ObservableProperty] partial-property mode is the only path
      that's WinRT/CsWinRT-compatible for WinUI 3 (per MVVMTK0045).
    -->
    <LangVersion>preview</LangVersion>

    <DisableXamlGeneratedMain>true</DisableXamlGeneratedMain>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!--
      Self-contained Windows App SDK (no bootstrapper needed; everything
      in the MSIX). For unpackaged local runs we still leave self-contained
      on so a fresh dev box doesn't need WinAppSDK runtime installed.
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="H.NotifyIcon.WinUI" />
    <!--
      Slice 33 msix-packaging: pin System.Security.Permissions 8.0.0
      because the WinAppSdkValidateAppxManifestItems MSBuild task
      ships in tools\net6.0\Microsoft.Windows.SDK.BuildTools.MSIX.dll
      and binds to System.Security.Permissions 8.0.0 — which is NOT
      in the .NET 10 SDK's default task host probing path. Without
      this explicit reference, /p:WindowsPackageType=MSIX fails with
      MSB4018 FileNotFoundException for System.Security.Permissions.
      GeneratePathProperty=true exposes $(PkgSystem_Security_Permissions)
      so the _EvalToolkitEnsureMsixTaskSysPerm target in the csproj can
      copy the assembly next to the MSIX task DLL.

      PrivateAssets=all keeps this build-only dependency out of the app's
      runtime closure — the assembly is consumed solely by the MSIX
      validate task, not by app code (GPT-5.5 slice-33 code-review NB #2).
    -->
    <PackageReference Include="System.Security.Permissions"
                     GeneratePathProperty="true"
                     PrivateAssets="all"
                     ExcludeAssets="runtime;native;contentFiles;analyzers;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EvalToolkit.Core\EvalToolkit.Core.csproj" />
    <ProjectReference Include="..\EvalToolkit.EvalGen\EvalToolkit.EvalGen.csproj" />
    <ProjectReference Include="..\EvalToolkit.EvalScore\EvalToolkit.EvalScore.csproj" />
    <ProjectReference Include="..\EvalToolkit.Jobs\EvalToolkit.Jobs.csproj" />
    <ProjectReference Include="..\EvalToolkit.WorkIQ\EvalToolkit.WorkIQ.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Slice 33 msix-packaging — single-project MSIX wiring.

    `AppxManifest` registers Package.appxmanifest with the WinAppSDK
    MSIX targets; `Content` ensures the per-arch packaging PNGs are
    embedded under Assets\Packaging\ inside the MSIX so the manifest's
    Logo / Square150x150Logo / FTA logo references resolve at runtime.

    GenerateAppxPackageOnBuild / AppxBundle are conditioned on
    WindowsPackageType=MSIX so they never activate during unpackaged
    F5 / dotnet build / dotnet run (which would error out — GPT-5.5
    slice-33 plan review BLOCKER #3). AppxPackageSigningEnabled=false
    because slice 34 (signing) handles signing — slice 33 produces
    unsigned, structurally-valid MSIX.
  -->
  <ItemGroup Condition="'$(WindowsPackageType)'=='MSIX'">
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <ItemGroup Condition="'$(WindowsPackageType)'=='MSIX'">
    <Content Include="Assets\Packaging\**\*.png"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition="'$(WindowsPackageType)'=='MSIX'">
    <GenerateAppxPackageOnBuild>true</GenerateAppxPackageOnBuild>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxPackageDir>$(MSBuildProjectDirectory)\AppPackages\</AppxPackageDir>
  </PropertyGroup>

  <!--
    Slice 33 msix-packaging — workaround for missing
    System.Security.Permissions 8.0.0 in the MSBuild task-host probing
    path under .NET 10. The WinAppSdkValidateAppxManifestItems task
    (shipped in Microsoft.Windows.SDK.BuildTools.MSIX 1.7.x
    tools\net6.0\) binds to System.Security.Permissions 8.0.0 but the
    package does not ship that assembly alongside it. Copy the
    restored assembly next to the task DLL before the validate target
    runs, so the assembly load resolves locally.

    Conditioned on WindowsPackageType=MSIX so unpackaged builds (which
    don't run the task) skip the copy entirely.
  -->
  <Target Name="_EvalToolkitEnsureMsixTaskSysPerm"
          BeforeTargets="_ValidatePresenceOfAppxManifestItems"
          Condition="'$(WindowsPackageType)'=='MSIX' And '$(MSBuildRuntimeType)'=='Core' And '$(MsixTaskAssemblyLocation)'!=''">
    <PropertyGroup>
      <_SysPermAssemblyPath>$(PkgSystem_Security_Permissions)\lib\net8.0\System.Security.Permissions.dll</_SysPermAssemblyPath>
    </PropertyGroup>

    <!--
      Fail-fast (GPT-5.5 slice-33 code-review NB #1): if the System.Security.Permissions
      assembly is missing from the restored package, surface a clear actionable error
      instead of falling through to the opaque MSB4018 FileNotFoundException raised
      later by the WinAppSdkValidateAppxManifestItems task.
    -->
    <Error Text="Slice 33 MSIX prerequisite missing: '$(_SysPermAssemblyPath)' not found. Run 'dotnet restore' against EvalToolkit.UI.csproj so the System.Security.Permissions 8.0.0 package is materialised, then retry. See packaging/msix/README.md for context."
           Condition="!Exists('$(_SysPermAssemblyPath)')" />

    <ItemGroup>
      <_SysPermAssembly Include="$(_SysPermAssemblyPath)" />
    </ItemGroup>
    <Copy SourceFiles="@(_SysPermAssembly)"
          DestinationFolder="$(MsixTaskAssemblyLocation)"
          SkipUnchangedFiles="true" />
  </Target>

  <!--
    Slice 27 webview2-bootstrap — conditionally bundle the WebView2
    Evergreen Bootstrapper. The binary is owned by Microsoft and rolls
    forward; the production CI step downloads it before publish and
    drops it at Assets\webview2\MicrosoftEdgeWebview2Setup.exe. Dev
    builds without the file still compile; the WizardView fallback
    panel detects the missing binary at runtime and falls back to the
    public fwlink. See src\EvalToolkit.UI\Assets\webview2\README.md.
  -->
  <ItemGroup>
    <Content Include="Assets\webview2\MicrosoftEdgeWebview2Setup.exe"
             Condition="Exists('Assets\webview2\MicrosoftEdgeWebview2Setup.exe')"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
