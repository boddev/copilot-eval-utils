<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvalToolkit.UI.Views.DiagnosticsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:EvalToolkit.UI.ViewModels"
    xmlns:models="using:EvalToolkit.UI.Models">

    <Page.Resources>
        <Style x:Key="SectionCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </Page.Resources>

    <ScrollViewer Padding="24">
        <StackPanel Spacing="16" MaxWidth="900" HorizontalAlignment="Stretch">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Grid.Column="0"
                        x:Name="BackButton"
                        VerticalAlignment="Top"
                        Margin="0,4,12,0"
                        Click="BackButton_Click"
                        ToolTipService.ToolTip="Back to the evaluation wizard">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72B;" FontSize="14"/>
                        <TextBlock Text="Back"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="Diagnostics"
                               FontSize="24"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Subsystem health probes for support / CI smoke."
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
                <Button Grid.Column="2"
                        VerticalAlignment="Top"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressBar IsIndeterminate="True"
                         Visibility="{x:Bind ViewModel.IsRefreshing, Mode=OneWay}"/>

            <InfoBar IsOpen="{x:Bind HasError, Mode=OneWay}"
                     Severity="Error"
                     Title="Probe failed"
                     Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                     IsClosable="False"/>

            <Grid x:Name="SectionsGrid"
                  Visibility="{x:Bind HasReport, Mode=OneWay}"
                  RowSpacing="12"
                  RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">

                <Border Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="16">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="Auto,*">
                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind OverallGlyph, Mode=OneWay}"
                                       FontSize="20"
                                       Margin="0,0,8,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{x:Bind OverallHeader, Mode=OneWay}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="{x:Bind GeneratedAtDisplay, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        <TextBlock Text="{x:Bind AppVersionDisplay, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Workspace" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind WorkspaceLine1, Mode=OneWay}" FontSize="12"/>
                        <TextBlock Text="{x:Bind WorkspaceLine2, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="WebView2 runtime" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind WebView2Line1, Mode=OneWay}" FontSize="12"/>
                        <TextBlock Text="{x:Bind WebView2Line2, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Notifications" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind NotificationsLine, Mode=OneWay}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Jump list" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind JumpListLine1, Mode=OneWay}" FontSize="12"/>
                        <TextBlock Text="{x:Bind JumpListLine2, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="5" Style="{StaticResource SectionCard}">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Process" FontWeight="SemiBold"/>
                        <TextBlock Text="{x:Bind ProcessLine1, Mode=OneWay}" FontSize="12"/>
                        <TextBlock Text="{x:Bind ProcessLine2, Mode=OneWay}"
                                   FontSize="12"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</Page>
