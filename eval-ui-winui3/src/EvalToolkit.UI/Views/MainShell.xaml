<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvalToolkit.UI.Views.MainShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:vm="using:EvalToolkit.UI.ViewModels"
    xmlns:views="using:EvalToolkit.UI.Views">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,*,Auto,Auto">

                <Grid Grid.Row="0" Padding="16,12" ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Text="Jobs"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1"
                            Command="{x:Bind ViewModel.Sidebar.RefreshCommand}"
                            ToolTipService.ToolTip="Refresh">
                        <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                    </Button>
                </Grid>

                <ListView Grid.Row="1"
                          x:Name="JobsList"
                          SelectionMode="Single"
                          IsItemClickEnabled="True"
                          ItemClick="JobsList_ItemClick"
                          RightTapped="JobsList_RightTapped"
                          Padding="8,0,8,8">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:JobSummaryViewModel">
                            <Grid Padding="8" RowDefinitions="Auto,Auto,Auto"
                                  ColumnDefinitions="Auto,*">
                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="{x:Bind StatusGlyph}"
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{x:Bind DisplayName}"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{x:Bind CreatedDisplay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{x:Bind CountsDisplay}"
                                           FontSize="11"
                                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <TextBlock Grid.Row="2"
                           x:Name="EmptyHintText"
                           Margin="16,8"
                           Text="No jobs yet. Run an evaluation to populate this list."
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           Visibility="Collapsed"/>

                <Border Grid.Row="3"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="0,1,0,0"
                        Padding="12,8">
                    <Button x:Name="DiagnosticsButton"
                            HorizontalAlignment="Stretch"
                            Click="DiagnosticsButton_Click"
                            ToolTipService.ToolTip="Open the diagnostics view">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9F5;" FontSize="14"/>
                            <TextBlock Text="Diagnostics"/>
                        </StackPanel>
                    </Button>
                </Border>

            </Grid>
        </Border>

        <Frame Grid.Column="1" x:Name="ContentFrame"/>
    </Grid>
</Page>



