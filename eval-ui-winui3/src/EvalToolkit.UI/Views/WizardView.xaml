<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="EvalToolkit.UI.Views.WizardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    xmlns:models="using:EvalToolkit.UI.Models"
    xmlns:vm="using:EvalToolkit.UI.ViewModels">

    <Page.Resources>
        <Style x:Key="PanelStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource LayerFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
        <Style x:Key="StepHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="StepDescriptionStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
    </Page.Resources>

    <Grid Padding="32,16,32,16" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header strip with current-step indicator -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE8A5;" FontSize="20"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
            <TextBlock Text="{x:Bind ViewModel.StepHeader, Mode=OneWay}"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Step content area; only one step is visible at a time -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid RowSpacing="0">
                <!-- ============ STEP 1: Dataset picker ============ -->
                <Border x:Name="Step1Panel"
                        Style="{StaticResource PanelStyle}"
                        DataContext="{x:Bind ViewModel.DatasetPicker, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.IsStep1Visible, Mode=OneWay}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource StepHeadingStyle}"
                                   Text="Choose your dataset"/>
                        <TextBlock Style="{StaticResource StepDescriptionStyle}"
                                   Text="Select one or more files, or an entire folder. You can also drag-and-drop items below."/>

                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button x:Name="BrowseFilesButton"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{x:Bind ViewModel.DatasetPicker.BrowseFilesCommand}"
                                    Content="Browse files…"/>
                            <Button x:Name="BrowseFolderButton"
                                    Command="{x:Bind ViewModel.DatasetPicker.BrowseFolderCommand}"
                                    Content="Browse folder…"/>
                            <Button x:Name="ClearButton"
                                    Command="{x:Bind ViewModel.DatasetPicker.ClearCommand}"
                                    Content="Clear all"/>
                        </StackPanel>

                        <Border x:Name="DropZone"
                                AllowDrop="True"
                                Background="Transparent"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                MinHeight="80"
                                Padding="16"
                                DragOver="DropZone_DragOver"
                                Drop="DropZone_Drop">
                            <TextBlock Text="Drop files or folders here"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Border>

                        <TextBlock x:Name="SummaryText"
                                   Text="{Binding Summary}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   Margin="0,4,0,0"/>

                        <ListView x:Name="SelectionList"
                                  ItemsSource="{Binding Selection}"
                                  MaxHeight="240"
                                  SelectionMode="None"
                                  IsItemClickEnabled="False">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DatasetPath">
                                    <Grid Padding="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  FontSize="16"
                                                  Margin="0,0,12,0"
                                                  Glyph="&#xE7C3;"/>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{x:Bind Path}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{x:Bind Kind}"
                                                       FontSize="11"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Grid.Column="2"
                                                Content="Remove"
                                                Tag="{x:Bind}"
                                                Click="RemoveItem_Click"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>

                <!-- ============ STEP 2: Describe ============ -->
                <Border x:Name="Step2Panel"
                        Style="{StaticResource PanelStyle}"
                        DataContext="{x:Bind ViewModel.Describe, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.IsStep2Visible, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource StepHeadingStyle}"
                                   Text="Describe the data"/>
                        <TextBlock Style="{StaticResource StepDescriptionStyle}"
                                   Text="Plain-language description helps the generator create grounded questions."/>

                        <TextBox x:Name="DescriptionBox"
                                 Header="Dataset description"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="100"
                                 PlaceholderText="Example: Environmental datasets with country, year, CO2 emissions, greenhouse gas metrics, and World Bank climate indicators."
                                 Text="{Binding Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <controls:NumberBox Grid.Column="0"
                                                Header="Number of evaluations"
                                                Minimum="10"
                                                Maximum="50"
                                                SpinButtonPlacementMode="Inline"
                                                Value="{Binding Count, Mode=TwoWay}"
                                                Width="180"/>
                            <TextBox Grid.Column="1"
                                     Header="File types to include"
                                     Text="{Binding Extensions, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Expander x:Name="AdvancedOptionsExpander"
                                  Header="Advanced options"
                                  HorizontalAlignment="Stretch"
                                  Expanding="AdvancedOptionsExpander_Expanding"
                                  Collapsed="AdvancedOptionsExpander_Collapsed">
                            <Grid ColumnSpacing="16" RowSpacing="12" Padding="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <ComboBox Grid.Row="0" Grid.Column="0"
                                          ItemsSource="{x:Bind vm:DescribeViewModel.ProviderOptions}"
                                          DisplayMemberPath="Label"
                                          SelectedValuePath="Value"
                                          SelectedValue="{Binding Provider, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Generation provider" VerticalAlignment="Center"/>
                                            <FontIcon Glyph="&#xE946;" FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      ToolTipService.ToolTip="The service used to generate evaluation questions from your dataset. Microsoft 365 Copilot and WorkIQ route through your local sign-in; Azure OpenAI and GitHub Copilot CLI require their own configuration."/>
                                        </StackPanel>
                                    </ComboBox.Header>
                                </ComboBox>

                                <!-- Model field adapts to the chosen provider:
                                     GitHub Copilot -> editable dropdown of known models,
                                     Azure OpenAI -> free-text deployment name,
                                     M365 / WorkIQ -> managed by the provider (Auto). -->
                                <ComboBox Grid.Row="0" Grid.Column="1"
                                          IsEditable="True"
                                          HorizontalAlignment="Stretch"
                                          PlaceholderText="{x:Bind ViewModel.Describe.ModelPlaceholder, Mode=OneWay}"
                                          ItemsSource="{x:Bind ViewModel.Describe.AvailableModels, Mode=OneWay}"
                                          Text="{x:Bind ViewModel.Describe.Model, Mode=TwoWay}"
                                          Visibility="{x:Bind ViewModel.Describe.IsModelDropdown, Mode=OneWay}">
                                    <ComboBox.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Model or deployment name" VerticalAlignment="Center"/>
                                            <FontIcon Glyph="&#xE946;" FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      ToolTipService.ToolTip="Which model the provider should use. GitHub Copilot: pick from the list or type a model id. Azure OpenAI: enter your deployment name. Microsoft 365 / WorkIQ: managed automatically (Auto)."/>
                                        </StackPanel>
                                    </ComboBox.Header>
                                </ComboBox>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         PlaceholderText="Deployment name"
                                         Text="{x:Bind ViewModel.Describe.Model, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{x:Bind ViewModel.Describe.IsModelTextBox, Mode=OneWay}">
                                    <TextBox.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Model or deployment name" VerticalAlignment="Center"/>
                                            <FontIcon Glyph="&#xE946;" FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      ToolTipService.ToolTip="Which model the provider should use. GitHub Copilot: pick from the list or type a model id. Azure OpenAI: enter your deployment name. Microsoft 365 / WorkIQ: managed automatically (Auto)."/>
                                        </StackPanel>
                                    </TextBox.Header>
                                </TextBox>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         IsEnabled="False"
                                         Text="{x:Bind ViewModel.Describe.Model, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.Describe.IsModelAuto, Mode=OneWay}">
                                    <TextBox.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Model or deployment name" VerticalAlignment="Center"/>
                                            <FontIcon Glyph="&#xE946;" FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      ToolTipService.ToolTip="Which model the provider should use. GitHub Copilot: pick from the list or type a model id. Azure OpenAI: enter your deployment name. Microsoft 365 / WorkIQ: managed automatically (Auto)."/>
                                        </StackPanel>
                                    </TextBox.Header>
                                </TextBox>

                                <TextBox Grid.Row="1" Grid.Column="0"
                                         PlaceholderText="Optional"
                                         Text="{Binding M365TenantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                    <TextBox.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="Microsoft 365 tenant ID" VerticalAlignment="Center"/>
                                            <FontIcon Glyph="&#xE946;" FontSize="14"
                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                      ToolTipService.ToolTip="Optional Microsoft Entra (Azure AD) tenant GUID to target when using a Microsoft 365 provider. Leave blank to use your default tenant."/>
                                        </StackPanel>
                                    </TextBox.Header>
                                </TextBox>
                                <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             PlaceholderText="Optional path"
                                             Text="{Binding ConnectorSchemaPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="Connector schema JSON" VerticalAlignment="Center"/>
                                                <FontIcon Glyph="&#xE946;" FontSize="14"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          ToolTipService.ToolTip="Optional path to a JSON file describing your connector's schema (fields and types). Used to ground generated questions in your data's structure."/>
                                            </StackPanel>
                                        </TextBox.Header>
                                    </TextBox>
                                    <Button Grid.Column="1"
                                            VerticalAlignment="Bottom"
                                            Content="Browse…"
                                            Click="BrowseSchema_Click"/>
                                </Grid>
                            </Grid>
                        </Expander>
                    </StackPanel>
                </Border>
                <!-- ============ STEP 3: Progress ============ -->
                <Border x:Name="Step3Panel"
                        Style="{StaticResource PanelStyle}"
                        DataContext="{x:Bind ViewModel.Progress, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.IsStep3Visible, Mode=OneWay}">
                    <StackPanel Spacing="14">
                        <TextBlock Style="{StaticResource StepHeadingStyle}"
                                   Text="Generating evaluation set"/>
                        <TextBlock Style="{StaticResource StepDescriptionStyle}"
                                   Text="The job is running. You can watch live progress below or cancel at any time."/>

                        <Grid ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="{Binding Phase}"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1"
                                       Text="{Binding StatusMessage}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <ProgressBar IsIndeterminate="{Binding IsIndeterminate}"
                                     Value="{Binding PercentValue}"
                                     Minimum="0"
                                     Maximum="100"
                                     ShowError="{Binding IsFailed}"/>

                        <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="0"
                                MaxHeight="300">
                            <ScrollViewer x:Name="LogScrollViewer"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto"
                                          Padding="12,8">
                                <ItemsRepeater ItemsSource="{Binding LogLines}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Text="{x:Bind}"
                                                       FontFamily="Consolas"
                                                       FontSize="12"
                                                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                                       Margin="0,1"
                                                       TextWrapping="NoWrap"/>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>
                        </Border>

                        <controls:InfoBar
                            IsOpen="{x:Bind ViewModel.Progress.IsComplete, Mode=OneWay}"
                            Severity="Success"
                            IsClosable="False"
                            Title="Generation complete"
                            Message="{x:Bind ViewModel.Progress.StatusMessage, Mode=OneWay}"/>

                        <controls:InfoBar
                            IsOpen="{x:Bind ViewModel.Progress.IsFailed, Mode=OneWay}"
                            Severity="Error"
                            IsClosable="False"
                            Title="Generation failed"
                            Message="{x:Bind ViewModel.Progress.StatusMessage, Mode=OneWay}"/>

                        <!--
                            Slice 23: action row visibility tracks HasOutputs
                            (set as soon as the service emits the job folder),
                            so the "Open output folder" button is reachable on
                            cancel/failure too. The CSV/review buttons remain
                            disabled by their CanExecute predicates until those
                            specific files have been written.
                        -->
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    Visibility="{x:Bind ViewModel.Progress.HasOutputs, Mode=OneWay}">
                            <Button Content="Open CSV in Excel"
                                    Style="{ThemeResource AccentButtonStyle}"
                                    Command="{Binding OpenCsvCommand}"/>
                            <Button Content="Open review"
                                    Command="{Binding OpenReviewCommand}"/>
                            <Button Content="Show in folder"
                                    Command="{Binding RevealCsvCommand}"/>
                            <Button Content="Open output folder"
                                    Command="{Binding OpenOutputFolderCommand}"/>
                            <Button Content="Edit rows…"
                                    Command="{x:Bind ViewModel.GoToEditorCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ STEP 4: Row editor ============ -->
                <Border x:Name="Step4Panel"
                        Style="{StaticResource PanelStyle}"
                        DataContext="{x:Bind ViewModel.Editor, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.IsStep4Visible, Mode=OneWay}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource StepHeadingStyle}"
                                   Text="Review and edit rows"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource StepDescriptionStyle}"
                                   Text="Edit prompts and expected answers in place. Save writes back to the same CSV so scoring picks up your changes."/>

                        <Grid Grid.Row="2" ColumnSpacing="12" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="{Binding CsvPath}"
                                           FontFamily="Consolas"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="EditorStatusLine"
                                           Text="{x:Bind ViewModel.Editor.DirtyCount, Mode=OneWay}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Save"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Command="{Binding SaveCommand}"/>
                                <Button Content="Revert all"
                                        Command="{Binding RevertAllCommand}"/>
                                <Button Content="Reload"
                                        Command="{Binding ReloadCommand}"/>
                                <Button Content="Score…"
                                        Command="{x:Bind ViewModel.GoToScoreCommand}"/>
                            </StackPanel>
                        </Grid>

                        <controls:InfoBar Grid.Row="3"
                            IsOpen="{x:Bind ViewModel.Editor.HasError, Mode=OneWay}"
                            Severity="Error"
                            IsClosable="True"
                            Title="Save error"
                            Message="{x:Bind ViewModel.Editor.ErrorMessage, Mode=OneWay}"/>

                        <ListView Grid.Row="4"
                                  x:Name="EditorRowsList"
                                  ItemsSource="{Binding Rows}"
                                  SelectionMode="None"
                                  MaxHeight="640">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="vm:EvalRowViewModel">
                                    <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="0,12,0,12">
                                        <Grid ColumnSpacing="8" RowSpacing="6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <FontIcon Grid.Row="0" Grid.Column="0"
                                                      Glyph="&#xE7BA;"
                                                      FontSize="12"
                                                      VerticalAlignment="Top"
                                                      Margin="0,8,4,0"
                                                      Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                      Visibility="{x:Bind IsDirty, Mode=OneWay}"/>
                                            <TextBox Grid.Row="0" Grid.Column="1"
                                                     Header="Prompt"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="70"
                                                     Text="{x:Bind Prompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Row="0" Grid.Column="2"
                                                     Header="Expected answer"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="70"
                                                     Text="{x:Bind ExpectedAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Row="1" Grid.Column="1"
                                                     Header="Source location"
                                                     Text="{x:Bind SourceLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            <TextBox Grid.Row="1" Grid.Column="2"
                                                     Header="Actual answer (filled by scoring)"
                                                     AcceptsReturn="True"
                                                     TextWrapping="Wrap"
                                                     MinHeight="50"
                                                     Text="{x:Bind ActualAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>

                <!-- ============ STEP 5: Score ============ -->
                <Border x:Name="Step5Panel"
                        Style="{StaticResource PanelStyle}"
                        DataContext="{x:Bind ViewModel.Score, Mode=OneTime}"
                        Visibility="{x:Bind ViewModel.IsStep5Visible, Mode=OneWay}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Style="{StaticResource StepHeadingStyle}"
                                   Text="Score the evaluation set"/>
                        <TextBlock Grid.Row="1" Style="{StaticResource StepDescriptionStyle}"
                                   Text="Send each prompt to WorkIQ, then have a judge compare answers. Edited rows from Step 4 are merged into the sidecar automatically before scoring runs."/>

                        <InfoBar Grid.Row="2"
                                 IsOpen="{x:Bind ViewModel.Score.HasError, Mode=OneWay}"
                                 Severity="Error"
                                 Title="Scoring error"
                                 Message="{x:Bind ViewModel.Score.ErrorMessage, Mode=OneWay}"/>

                        <Grid Grid.Row="3" ColumnSpacing="24" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBox Grid.Row="0" Grid.Column="0"
                                     Header="Connector ID (optional)"
                                     PlaceholderText="e.g. MyConnector-1234"
                                     Text="{x:Bind ViewModel.Score.ConnectorId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="0" Grid.Column="1"
                                     Header="M365 tenant ID (optional)"
                                     PlaceholderText="GUID"
                                     Text="{x:Bind ViewModel.Score.TenantId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <controls:NumberBox Grid.Row="1" Grid.Column="0"
                                       Header="Pass threshold (0–100)"
                                       Minimum="0"
                                       Maximum="100"
                                       SpinButtonPlacementMode="Compact"
                                       SmallChange="5"
                                       LargeChange="10"
                                       Value="{x:Bind ViewModel.Score.Threshold, Mode=TwoWay}"/>
                            <ComboBox Grid.Row="1" Grid.Column="1"
                                      Header="Judge provider"
                                      SelectedValue="{x:Bind ViewModel.Score.JudgeProviderWire, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="WorkIQ (default)" Tag="workiq"/>
                                <ComboBoxItem Content="Azure OpenAI" Tag="azure-openai"/>
                                <ComboBoxItem Content="GitHub Copilot CLI" Tag="github-copilot"/>
                            </ComboBox>

                            <TextBox Grid.Row="2" Grid.Column="0"
                                     Header="M365 agent ID (optional, enables A2A)"
                                     PlaceholderText="agent-id"
                                     Text="{x:Bind ViewModel.Score.M365AgentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBox Grid.Row="2" Grid.Column="1"
                                     Header="Judge agent ID (optional)"
                                     PlaceholderText="judge-agent-id"
                                     Text="{x:Bind ViewModel.Score.JudgeAgentId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                     Header="System prompt (optional)"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="80"
                                     Text="{x:Bind ViewModel.Score.SystemPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </Grid>

                        <Grid Grid.Row="4" ColumnSpacing="12" RowSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Spacing="8">
                                <Button Content="Run scoring"
                                        Style="{ThemeResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.RunScoreCommand}"/>
                                <Button Content="Cancel"
                                        Command="{x:Bind ViewModel.CancelScoreCommand}"
                                        Visibility="{x:Bind ViewModel.Score.IsRunning, Mode=OneWay}"/>
                                <TextBlock VerticalAlignment="Center"
                                           Text="{x:Bind ViewModel.Score.StatusMessage, Mode=OneWay}"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                                         Minimum="0" Maximum="100"
                                         IsIndeterminate="{x:Bind ViewModel.Score.IsIndeterminate, Mode=OneWay}"
                                         Value="{x:Bind ViewModel.Score.PercentValue, Mode=OneWay}"
                                         Visibility="{x:Bind ViewModel.Score.IsRunning, Mode=OneWay}"/>

                            <ScrollViewer Grid.Row="2" Grid.Column="0"
                                          MaxHeight="360"
                                          VerticalScrollBarVisibility="Auto"
                                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                          BorderThickness="1"
                                          Padding="8">
                                <ItemsRepeater ItemsSource="{x:Bind ViewModel.Score.LogLines, Mode=OneWay}">
                                    <ItemsRepeater.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock FontFamily="Cascadia Mono, Consolas, monospace"
                                                       FontSize="12"
                                                       TextWrapping="Wrap"
                                                       Text="{x:Bind}"/>
                                        </DataTemplate>
                                    </ItemsRepeater.ItemTemplate>
                                </ItemsRepeater>
                            </ScrollViewer>

                            <Border Grid.Row="2" Grid.Column="1"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    MinHeight="360"
                                    Padding="0">
                                <Grid>
                                    <controls:WebView2 x:Name="ReportWebView"
                                                       NavigationStarting="ReportWebView_NavigationStarting"/>
                                    <!-- Slice 27: native XAML fallback when WebView2 runtime is missing.
                                         Per GPT-5.5 review, rendering an error HTML into the same WebView2
                                         control would also fail, so we collapse the WebView2 and show
                                         a real XAML surface that gives the user a working escape hatch.
                                         Visibility is driven from code-behind, not bound to a VM. -->
                                    <Border x:Name="WebView2FallbackPanel"
                                            Background="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}"
                                            Padding="16"
                                            Visibility="Collapsed">
                                        <StackPanel Spacing="10" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource SubtitleTextBlockStyle}"
                                                       Text="WebView2 Runtime required" />
                                            <TextBlock TextWrapping="Wrap"
                                                       Text="The Microsoft Edge WebView2 Runtime isn't installed on this machine, so the rendered report can't be shown inline. The report is still on disk and opens fine in any markdown viewer." />
                                            <TextBlock x:Name="WebView2FallbackStatus"
                                                       TextWrapping="Wrap"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <Button x:Name="WebView2InstallButton"
                                                        Style="{StaticResource AccentButtonStyle}"
                                                        Click="WebView2InstallButton_Click"
                                                        Content="Install WebView2 (recommended)" />
                                                <Button x:Name="WebView2OpenManualButton"
                                                        Click="WebView2OpenManualButton_Click"
                                                        Content="Get installer" />
                                                <Button x:Name="WebView2RetryButton"
                                                        Click="WebView2RetryButton_Click"
                                                        Content="Retry inline view"
                                                        ToolTipService.ToolTip="After installing WebView2 externally, click to re-check and re-render the report inline." />
                                                <Button x:Name="WebView2OpenReportFromFallbackButton"
                                                        Click="WebView2OpenReportFromFallbackButton_Click"
                                                        Content="Open report (.md)" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Spacing="8"
                                        Visibility="{x:Bind ViewModel.Score.IsComplete, Mode=OneWay}">
                                <Button Content="Open report (.md)"
                                        Command="{x:Bind ViewModel.Score.OpenReportCommand}"/>
                                <Button Content="Open scored CSV"
                                        Command="{x:Bind ViewModel.Score.OpenScoredCsvCommand}"/>
                                <Button Content="Open output folder"
                                        Command="{x:Bind ViewModel.Score.OpenOutputFolderCommand}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

            </Grid>
        </ScrollViewer>

        <!-- Navigation bar -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Back"
                    Command="{x:Bind ViewModel.GoBackCommand}"/>
            <Button Grid.Column="1"
                    Content="Start over"
                    Command="{x:Bind ViewModel.StartOverCommand}"
                    Visibility="{x:Bind ViewModel.IsStep3Visible, Mode=OneWay}"/>
            <Button Grid.Column="3"
                    Content="Cancel"
                    Command="{x:Bind ViewModel.CancelCommand}"
                    Visibility="{x:Bind ViewModel.Progress.IsRunning, Mode=OneWay}"/>
            <Button Grid.Column="4"
                    Content="Next"
                    Command="{x:Bind ViewModel.GoNextCommand}"
                    Visibility="{x:Bind ViewModel.IsStep1Visible, Mode=OneWay}"/>
            <Button Grid.Column="5"
                    Style="{ThemeResource AccentButtonStyle}"
                    Content="Generate evaluation set"
                    Command="{x:Bind ViewModel.GenerateCommand}"
                    Visibility="{x:Bind ViewModel.IsStep2Visible, Mode=OneWay}"/>
        </Grid>
    </Grid>
</Page>
