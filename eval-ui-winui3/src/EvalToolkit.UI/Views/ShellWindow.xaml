<Window
    x:Class="EvalToolkit.UI.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls"
    Title="EvalToolkit">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Slim title bar / breadcrumb area. Drag region is set in code-behind so
             Mica + a styled title bar play nicely. -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="32"
              Background="Transparent">
            <TextBlock x:Name="AppTitleText"
                       Text="EvalToolkit"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
        </Grid>

        <!-- Slice 21 deliverable: just a navigable Frame. Step views
             come in later slices (winui-step1-2 onward). -->
        <controls:Frame x:Name="NavFrame" Grid.Row="1" />
    </Grid>
</Window>
